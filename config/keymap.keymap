#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /*
     * ================================================================
     * Input Processors
     * ================================================================
     */

    input_processors {
        /*
         * Vertical scroll only
         *
         * XY -> scroll 変換後、
         * horizontal wheel を vertical wheel にまとめる
         */
        vertical_only_scroll: vertical_only_scroll {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;

            type = <INPUT_EV_REL>;

            map = <
                INPUT_REL_HWHEEL INPUT_REL_WHEEL
            >;
        };

        /*
         * Horizontal scroll only
         *
         * XY -> scroll 変換後、
         * vertical wheel を horizontal wheel にまとめる
         */
        horizontal_only_scroll: horizontal_only_scroll {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;

            type = <INPUT_EV_REL>;

            map = <
                INPUT_REL_WHEEL INPUT_REL_HWHEEL
            >;
        };
    };


    /*
     * ================================================================
     * Combos
     * ================================================================
     */

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };


    /*
     * ================================================================
     * Macros
     * ================================================================
     */

    macros {
        /*
         * ------------------------------------------------------------
         * Ctrl + Left Click
         *
         * QMK:
         * KEEP_AML_Cclick 相当
         *
         * Ctrl押下
         * ↓
         * 左クリック
         * ↓
         * Ctrl解放
         * ------------------------------------------------------------
         */

        ctrl_click: ctrl_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <20>;
            tap-ms = <30>;

            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &mkp LCLK>,
                <&macro_release &kp LCTRL>;
        };


        /*
         * ------------------------------------------------------------
         * Test macro
         * ------------------------------------------------------------
         */

        hello_macro: hello_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp H
                &kp E
                &kp L
                &kp L
                &kp O
            >;
        };


        /*
         * ============================================================
         * Bracket macros
         * ============================================================
         */


        /*
         * ()
         *  ^
         */

        double_parentheses: double_parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp LPAR
                &kp RPAR
                &kp LEFT
            >;
        };


        /*
         * []
         *  ^
         */

        double_squarebrackets: double_squarebrackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp LBKT
                &kp RBKT
                &kp LEFT
            >;
        };


        /*
         * {}
         *  ^
         */

        double_curlybrackets: double_curlybrackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp LBRC
                &kp RBRC
                &kp LEFT
            >;
        };


        /*
         * ============================================================
         * TeX macros
         * ============================================================
         */


        /*
         * \left
         */

        tex_left: tex_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp L
                &kp E
                &kp F
                &kp T
            >;
        };


        /*
         * \right
         */

        tex_right: tex_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp R
                &kp I
                &kp G
                &kp H
                &kp T
            >;
        };


        /*
         * ^{}
         *  ^
         */

        tex_upper: tex_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp CARET
                &kp LBRC
                &kp RBRC
                &kp LEFT
            >;
        };


        /*
         * _{}
         *  ^
         */

        tex_lower: tex_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp UNDER
                &kp LBRC
                &kp RBRC
                &kp LEFT
            >;
        };


        /*
         * \frac{}{}
         *       ^
         */

        tex_frac: tex_frac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp F
                &kp R
                &kp A
                &kp C
                &kp LBRC
                &kp RBRC
                &kp LBRC
                &kp RBRC
                &kp LEFT
                &kp LEFT
                &kp LEFT
            >;
        };


        /*
         * \ge
         */

        tex_ge: tex_ge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp G
                &kp E
            >;
        };


        /*
         * \le
         */

        tex_le: tex_le {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp L
                &kp E
            >;
        };


        /*
         * $$
         *  ^
         */

        tex_dollar: tex_dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp DLLR
                &kp DLLR
                &kp LEFT
            >;
        };


        /*
         * , \dots,
         */

        tex_dots: tex_dots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp COMMA
                &kp SPACE
                &kp BSLH
                &kp D
                &kp O
                &kp T
                &kp S
                &kp COMMA
                &kp SPACE
            >;
        };


        /*
         * \[\]
         */

        tex_squarebrackets: tex_squarebrackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp LBKT
                &kp BSLH
                &kp RBKT
                &kp LEFT
                &kp LEFT
            >;
        };


        /*
         * \begin{}
         *
         * \end{}
         */

        tex_begin_end: tex_begin_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp B
                &kp E
                &kp G
                &kp I
                &kp N
                &kp LBRC
                &kp RBRC

                &kp ENTER
                &kp ENTER

                &kp BSLH
                &kp E
                &kp N
                &kp D
                &kp LBRC
                &kp RBRC

                &kp UP
                &kp UP
                &kp END
                &kp LEFT
            >;
        };


        /*
         * \begin{align*}
         *
         * \end{align*}
         */

        tex_align_astr: tex_align_astr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp BSLH
                &kp B
                &kp E
                &kp G
                &kp I
                &kp N
                &kp LBRC
                &kp A
                &kp L
                &kp I
                &kp G
                &kp N
                &kp ASTRK
                &kp RBRC

                &kp ENTER
                &kp ENTER

                &kp BSLH
                &kp E
                &kp N
                &kp D
                &kp LBRC
                &kp A
                &kp L
                &kp I
                &kp G
                &kp N
                &kp ASTRK
                &kp RBRC

                &kp UP
            >;
        };
    };


    /*
     * ================================================================
     * Keymap
     * ================================================================
     *
     * Layer 0 : Base
     * Layer 1 : Mouse
     * Layer 2 : Brackets / Cursor / punctuation
     * Layer 3 : Programming / TeX / Numbers
     * Layer 4 : Settings
     * Layer 5 : Horizontal Scroll
     * Layer 6 : Vertical Scroll
     * ================================================================
     */

    keymap {
        compatible = "zmk,keymap";


        /*
         * ============================================================
         * Layer 0
         * Base
         * ============================================================
         */

        layer_0 {
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                                                   &kp N6       &kp N7    &kp N8     &kp N9    &kp N0        &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E     &kp R     &kp T                                                    &kp Y        &kp U     &kp I      &kp O     &kp P         &kp BSPC
&kp CAPS   &kp A      &kp S     &kp D     &kp F     &kp G        &mkp LCLK                       &mkp RCLK   &kp H        &kp J     &kp K      &kp L     &kp MINUS     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V     &kp B        &kp SPACE                       &kp RET     &kp N        &kp M     &kp COMMA  &kp DOT   &kp TILDE     &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp LGUI  &kp TAB   &mt LSHIFT LANGUAGE_2  &kp SPACE  &mt LCTRL LANGUAGE_1  &lt 3 BSPC  &lt 2 ENTER &kp BSPC  &kp RALT   &kp RGUI  &kp RCTRL     &kp RCTRL
            >;
        };


        /*
         * ============================================================
         * Layer 1
         * Mouse
         *
         * QMK版:
         *
         * 上側:
         * Ctrl + Click
         * Horizontal Scroll
         *
         * 中央:
         * Ctrl+S
         * Left Click
         * Vertical Scroll
         * Right Click
         * Ctrl+T
         *
         * 下側:
         * Ctrl+Z
         * Ctrl+X
         * Ctrl+C
         * Ctrl+V
         * Ctrl+Y
         * ============================================================
         */

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans     &trans        &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans     &ctrl_click   &mo 5      &trans     &trans     &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &kp LC(S)  &mkp LCLK     &mo 6      &mkp RCLK  &kp LC(T)  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &kp LC(Z)  &kp LC(X)     &kp LC(C)  &kp LC(V)  &kp LC(Y)  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans     &trans        &trans     &trans     &trans     &trans
            >;
        };


        /*
         * ============================================================
         * Layer 2
         *
         * Brackets / Cursor / punctuation
         * ============================================================
         */

        layer_2 {
            bindings = <
&trans  &trans                   &trans                   &trans              &trans               &trans                         &trans           &trans          &trans           &trans          &trans           &trans
&trans  &kp GRAVE                &kp SQT                  &tex_left           &tex_right           &double_parentheses            &kp SPACE        &kp LPAR        &kp UP          &kp RPAR        &kp DEL          &trans
&trans  &kp LT                   &kp GT                   &kp LBRC            &kp RBRC              &double_curlybrackets  &trans  &trans  &mt RCTRL HOME  &kp LEFT        &kp DOWN        &kp RIGHT       &kp END          &trans
&trans  &tex_le                  &tex_ge                  &kp LBKT            &kp RBKT              &double_squarebrackets &trans  &trans  &kp EXCL        &kp QMARK       &kp SEMI        &kp COLON       &kp DQT          &trans
&trans  &trans                   &trans                   &trans              &trans                &trans                 &trans  &trans  &trans          &trans          &trans          &trans          &trans           &trans
            >;
        };


        /*
         * ============================================================
         * Layer 3
         *
         * Programming / TeX / Numbers
         * ============================================================
         */

        layer_3 {
            bindings = <
&trans  &trans      &trans      &trans           &trans           &trans                                &trans     &trans     &trans     &trans     &trans     &trans
&trans  &kp AT      &kp PIPE    &tex_frac        &tex_begin_end   &tex_align_astr                       &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &trans
&trans  &kp PRCNT   &tex_lower  &tex_upper       &kp BSLH         &kp DLLR           &trans  &trans      &kp N0     &kp N1     &kp N2     &kp N3     &kp N4     &trans
&trans  &kp HASH    &kp UNDER   &kp CARET        &kp AMPS         &tex_squarebrackets &trans &trans      &kp PLUS   &kp MINUS  &kp ASTRK  &kp FSLH   &kp EQUAL  &trans
&trans  &trans      &trans      &trans           &trans           &trans              &trans &trans      &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };


        /*
         * ============================================================
         * Layer 4
         * Settings
         * ============================================================
         */

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };


        /*
         * ============================================================
         * Layer 5
         *
         * Horizontal Scroll
         *
         * Layer 1の横スクロールキーを
         * 押している間だけ有効
         * ============================================================
         */

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };


        /*
         * ============================================================
         * Layer 6
         *
         * Vertical Scroll
         *
         * Layer 1の縦スクロールキーを
         * 押している間だけ有効
         * ============================================================
         */

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};


/*
 * ====================================================================
 * Trackball / Input Processor
 * ====================================================================
 *
 * 通常:
 * Trackball
 *   ↓
 * X/Y反転
 *   ↓
 * Mouse Cursor
 *   ↓
 * Layer 1 Auto Mouse Layer
 *
 * AML timeout:
 * 700ms
 *
 * Layer 5:
 * Horizontal Scroll
 *
 * Layer 6:
 * Vertical Scroll
 * ====================================================================
 */

&pointing_listener {

    /*
     * ================================================================
     * Normal Mouse
     * ================================================================
     *
     * X/Y両方を反転
     *
     * Trackball movement
     * -> Layer 1
     *
     * Timeout
     * -> 700ms
     */

    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_xy_scaler 6 5
        &zip_temp_layer 1 700
    >;


    /*
     * ================================================================
     * Horizontal Scroll
     * ================================================================
     *
     * Layer 5中のみ
     *
     * スクロールについては現在正常に動いているため
     * X/Y反転は入れない
     */

    horizontal_scroll_mode {
        layers = <5>;

        input-processors = <
            &zip_xy_transform INPUT_TRANSFORM_X_INVERT
            &zip_xy_to_scroll_mapper
            &horizontal_only_scroll
            &zip_scroll_scaler 6 5
            &zip_temp_layer 1 700
        >;
    };


    /*
     * ================================================================
     * Vertical Scroll
     * ================================================================
     *
     * Layer 6中のみ
     *
     * スクロールについては現在正常に動いているため
     * X/Y反転は入れない
     */

    vertical_scroll_mode {
        layers = <6>;

        input-processors = <
            &zip_xy_to_scroll_mapper
            &vertical_only_scroll
            &zip_scroll_scaler 6 5
            &zip_temp_layer 1 700
        >;
    };
};
