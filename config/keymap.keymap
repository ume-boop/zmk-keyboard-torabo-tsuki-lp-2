#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    macros {
        hello_macro: hello_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            wait-ms = <30>;
            tap-ms = <30>;

            bindings = <
                &kp H
                &kp E
                &kp L
                &kp L
                &kp O
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                                                   &kp N6       &kp N7    &kp N8     &kp N9    &kp N0        &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E     &kp R     &kp T                                                    &kp Y        &kp U     &kp I      &kp O     &kp P         &kp BSPC
&kp CAPS   &kp A      &kp S     &kp D     &kp F     &kp G        &mkp LCLK                       &mkp RCLK   &kp H        &kp J     &kp K      &kp L     &kp MINUS     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V     &kp B        &kp SPACE                       &kp RET     &kp N        &kp M     &kp COMMA  &kp DOT   &kp TILDE     &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp LGUI  &kp TAB  &mt LSHIFT LANGUAGE_2  &kp SPACE  &mt LCTRL LANGUAGE_1  &lt 5 BSPC  &lt 4 ENTER  &kp BSPC  &kp RALT   &kp RGUI  &kp RCTRL     &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans     &trans        &trans     &trans     &trans    &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans     &kp LC(LCLK)  &mo 3      &trans     &trans    &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &kp LC(S)  &mkp LCLK     &mo 2      &mkp RCLK  &kp LC(T)    &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &kp LC(Z)  &kp LC(X)     &kp LC(C)  &kp LC(V)  &kp LC(Y) &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans     &trans        &trans     &trans     &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans            &trans      &trans      &trans      &trans                      &trans          &trans        &trans            &trans             &trans         &trans
&trans  &kp GRAVE         &kp SQT           &trans      &trans      &trans                      &kp SPACE       &kp LPAR      &kp UP            &kp RPAR           &kp DEL        &trans
&trans  &kp LT            &kp GT            &kp LBRC    &kp RBRC    &kp N5      &trans  &trans  &kp HOME        &kp LEFT      &kp DOWN          &kp RIGHT          &kp END        &trans
&trans  &kp N6            &kp N7            &kp LBKT    &kp RBKT    &kp N0      &trans  &trans  &kp EXCL        &kp QMARK     &kp SEMI          &kp COLON          &kp DQT        &trans
&trans  &trans            &trans            &trans      &trans      &trans      &trans  &trans  &trans          &trans        &trans            &trans             &trans         &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans      &trans    &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans     &trans
&trans  &kp AT      &kp PIPE  &trans        &trans        &trans                      &kp N5            &kp N6     &kp N7         &kp N8     &kp N9     &trans
&trans  &kp PRCNT   &trans    &trans        &kp BSLH      &kp DLLR    &trans  &trans  &kp N0            &kp N1     &kp N2         &kp N3     &kp N4     &trans
&trans  &kp HASH    &kp UNDER &kp CARET     &kp AMPS      &trans      &trans  &trans  &kp PLUS          &kp MINUS  &kp ASTRK      &kp FSLH   &kp EQUAL  &trans
&trans  &trans      &trans    &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans     &trans
            >;
        };
    };
};
